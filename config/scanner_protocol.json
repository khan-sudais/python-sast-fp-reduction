{
  "protocol_version": "1.2.0",
  "language": "python",
  "scope": "production",
  "targeting_strategy": "shared_python_file_manifest",
  "target_file_extension": ".py",
  "excluded_directory_names": [
    "tests",
    "test",
    "testing",
    "docs",
    "doc",
    "examples",
    "example",
    "benchmarks",
    "benchmark",
    ".venv",
    "venv",
    "build",
    "dist"
  ],
  "bandit": {
    "config": "config/bandit.yaml",
    "tests": [
      "B102",
      "B108",
      "B301",
      "B307",
      "B324",
      "B501",
      "B602",
      "B603",
      "B608"
    ],
    "required_version": "1.9.4"
  },
  "semgrep": {
    "config": "config/semgrep-python-security.yml",
    "rule_ids": [
      "python.security.exec",
      "python.security.eval",
      "python.security.hardcoded-temp-path",
      "python.security.unsafe-deserialization",
      "python.security.weak-hash",
      "python.security.disabled-cert-validation",
      "python.security.subprocess-shell-true",
      "python.security.subprocess-execution",
      "python.security.dynamic-sql"
    ],
    "required_version": "1.176.1"
  },
  "bandit_config_sha256": "3aaf51415384abcc6c9ef12afa886a79b8dd997e6c7e6892f71c9d7dbc0bbe51",
  "semgrep_config_sha256": "a0fddfb599cbacd4357bd97594c7fe14176c9880a1f0b06a168064cffdc58e38"
}